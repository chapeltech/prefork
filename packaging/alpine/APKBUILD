# Maintainer: ChapelTech <packages@chapel.tech>
pkgname=prefork
pkgver=0.4
pkgrel=1
pkgdesc="Preforking helper for inetd-style services"
url="https://github.com/ChapelTech/prefork"
arch="all"
license="MIT"
makedepends="groff"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz"

build() {
	make CFLAGS="$CFLAGS" NROFF=/usr/bin/nroff
}

check() {
	local status=0

	./prefork -N 0 -n 1 /bin/true || status=$?
	[ "$status" -eq 1 ]
}

package() {
	install -Dm755 prefork "$pkgdir/usr/libexec/prefork"
	install -Dm644 prefork.8 "$pkgdir/usr/share/man/man8/prefork.8"
	install -Dm644 debian/copyright \
		"$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

sha512sums="
SKIP
"
